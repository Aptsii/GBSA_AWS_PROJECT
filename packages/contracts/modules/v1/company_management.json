{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CompanyManagementSnapshotsV1",
  "oneOf": [
    {"$ref": "#/$defs/CampaignSnapshot"},
    {"$ref": "#/$defs/CriterionVersionSnapshot"},
    {"$ref": "#/$defs/InvitationAuthorizationSnapshot"},
    {"$ref": "#/$defs/ConsentAuthorizationSnapshot"},
    {"$ref": "#/$defs/InvitationStateTransitionSnapshot"},
    {"$ref": "#/$defs/AuditAppendReceipt"},
    {"$ref": "#/$defs/CompanyDeletionTargetEnumerationSnapshot"},
    {"$ref": "#/$defs/CompanyDeletionTargetReceipt"}
  ],
  "$defs": {
    "CampaignSnapshot": {
      "title": "CampaignSnapshot",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "company_id",
        "campaign_id",
        "position_id",
        "competency_model_version_id",
        "status",
        "prohibited_topics",
        "interview_duration_minutes",
        "persona_definition"
      ],
      "properties": {
        "company_id": {"type": "string", "format": "uuid"},
        "campaign_id": {"type": "string", "format": "uuid"},
        "position_id": {"type": "string", "format": "uuid"},
        "competency_model_version_id": {"type": "string", "format": "uuid"},
        "status": {"type": "string", "enum": ["draft", "published", "closed"]},
        "prohibited_topics": {"type": "array", "items": {"type": "string"}},
        "interview_duration_minutes": {"type": "integer", "minimum": 10, "maximum": 120},
        "persona_definition": {"type": "object"}
      }
    },
    "CriterionVersionSnapshot": {
      "title": "CriterionVersionSnapshot",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "company_id",
        "competency_model_version_id",
        "position_id",
        "version_number",
        "status",
        "criteria"
      ],
      "properties": {
        "company_id": {"type": "string", "format": "uuid"},
        "competency_model_version_id": {"type": "string", "format": "uuid"},
        "position_id": {"type": "string", "format": "uuid"},
        "version_number": {"type": "integer", "minimum": 1},
        "status": {"type": "string", "enum": ["published", "retired"]},
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/EvaluationCriterionSnapshot"}
        }
      }
    },
    "EvaluationCriterionSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id",
        "code",
        "name",
        "description",
        "weight",
        "good_evidence",
        "weak_evidence",
        "abstain_guidance",
        "common_questions",
        "required"
      ],
      "properties": {
        "criterion_id": {"type": "string", "format": "uuid"},
        "code": {"type": "string"},
        "name": {"type": "string"},
        "description": {"type": "string"},
        "weight": {"type": "number", "minimum": 0},
        "good_evidence": {"type": "object"},
        "weak_evidence": {"type": "object"},
        "abstain_guidance": {"type": "string"},
        "common_questions": {"type": "array", "items": {"type": "string"}},
        "required": {"type": "boolean"}
      }
    },
    "InvitationAuthorizationSnapshot": {
      "title": "InvitationAuthorizationSnapshot",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "company_id",
        "invitation_id",
        "applicant_id",
        "campaign_id",
        "state",
        "expires_at",
        "authorized",
        "reason_code"
      ],
      "properties": {
        "company_id": {"type": "string", "format": "uuid"},
        "invitation_id": {"type": "string", "format": "uuid"},
        "applicant_id": {"type": "string", "format": "uuid"},
        "campaign_id": {"type": "string", "format": "uuid"},
        "state": {"type": "string"},
        "expires_at": {"type": "string", "format": "date-time"},
        "authorized": {"type": "boolean"},
        "reason_code": {"type": ["string", "null"]}
      }
    },
    "ConsentAuthorizationSnapshot": {
      "title": "ConsentAuthorizationSnapshot",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "company_id",
        "invitation_id",
        "consent_record_id",
        "policy_version",
        "purpose_codes",
        "retention_days",
        "accepted_at",
        "withdrawn_at",
        "authorized",
        "reason_code"
      ],
      "properties": {
        "company_id": {"type": "string", "format": "uuid"},
        "invitation_id": {"type": "string", "format": "uuid"},
        "consent_record_id": {"type": "string", "format": "uuid"},
        "policy_version": {"type": "string"},
        "purpose_codes": {"type": "array", "items": {"type": "string"}},
        "retention_days": {"type": "integer", "minimum": 1},
        "accepted_at": {"type": "string", "format": "date-time"},
        "withdrawn_at": {"type": ["string", "null"], "format": "date-time"},
        "authorized": {"type": "boolean"},
        "reason_code": {"type": ["string", "null"]}
      }
    },
    "InvitationStateTransitionSnapshot": {
      "title": "InvitationStateTransitionSnapshot",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "company_id",
        "invitation_id",
        "previous_state",
        "state",
        "row_version",
        "applied",
        "idempotency_key"
      ],
      "properties": {
        "company_id": {"type": "string", "format": "uuid"},
        "invitation_id": {"type": "string", "format": "uuid"},
        "previous_state": {"type": "string"},
        "state": {"type": "string"},
        "row_version": {"type": "integer", "minimum": 1},
        "applied": {"type": "boolean"},
        "idempotency_key": {"type": "string", "minLength": 16, "maxLength": 128}
      }
    },
    "AuditAppendReceipt": {
      "title": "AuditAppendReceipt",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "company_id",
        "audit_event_id",
        "action",
        "resource_type",
        "resource_id",
        "result"
      ],
      "properties": {
        "company_id": {"type": "string", "format": "uuid"},
        "audit_event_id": {"type": "string", "format": "uuid"},
        "action": {"type": "string", "minLength": 1},
        "resource_type": {"type": "string", "minLength": 1},
        "resource_id": {"type": "string", "format": "uuid"},
        "result": {"type": "string", "enum": ["succeeded", "denied", "failed"]}
      }
    },
    "CompanyDeletionTargetEnumerationSnapshot": {
      "title": "CompanyDeletionTargetEnumerationSnapshot",
      "type": "object",
      "additionalProperties": false,
      "required": ["company_id", "scope_type", "scope_id", "owner_lane", "targets"],
      "properties": {
        "company_id": {"type": "string", "format": "uuid"},
        "scope_type": {"type": "string", "enum": ["invitation", "applicant"]},
        "scope_id": {"type": "string", "format": "uuid"},
        "owner_lane": {"const": "A"},
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target_id", "target_type", "store", "target_version"],
            "properties": {
              "target_id": {"type": "string", "format": "uuid"},
              "target_type": {
                "type": "string",
                "enum": ["applicant", "audit_event", "consent_record", "invitation"]
              },
              "store": {"const": "aurora"},
              "target_version": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    },
    "CompanyDeletionTargetReceipt": {
      "title": "CompanyDeletionTargetReceipt",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "company_id",
        "deletion_request_id",
        "target_id",
        "owner_lane",
        "status",
        "attempts",
        "verified_at",
        "error_code"
      ],
      "properties": {
        "company_id": {"type": "string", "format": "uuid"},
        "deletion_request_id": {"type": "string", "format": "uuid"},
        "target_id": {"type": "string", "format": "uuid"},
        "owner_lane": {"const": "A"},
        "status": {"type": "string", "enum": ["deleting", "retrying", "failed", "verified_absent"]},
        "attempts": {"type": "integer", "minimum": 1},
        "verified_at": {"type": ["string", "null"], "format": "date-time"},
        "error_code": {"type": ["string", "null"]}
      }
    }
  }
}
