root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.py]
indent_size = 4
max_line_length = 100

[*.{js,jsx,ts,tsx,json,jsonc,yaml,yml,css,html}]
indent_size = 2

[*.{md,mdx}]
indent_size = 2
max_line_length = 100
trim_trailing_whitespace = false

[*.tf]
indent_size = 2

[Makefile]
indent_style = tab
