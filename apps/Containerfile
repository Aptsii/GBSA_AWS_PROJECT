# syntax=docker/dockerfile:1.7

FROM node:22.13.1-alpine AS workspace

RUN npm install --global pnpm@11.21.0

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/company-console/package.json apps/company-console/package.json
COPY apps/applicant-interview/package.json apps/applicant-interview/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/web-client/package.json packages/web-client/package.json

RUN pnpm install --frozen-lockfile

COPY apps apps
COPY packages/contracts packages/contracts
COPY packages/web-client packages/web-client

FROM workspace AS company-build
ARG VITE_COMPANY_IDENTITY_MODE=local
ARG VITE_COMPANY_IDENTITY_ENDPOINT
ARG VITE_COMPANY_IDENTITY_CLIENT_ID
ENV VITE_COMPANY_IDENTITY_MODE=${VITE_COMPANY_IDENTITY_MODE}
ENV VITE_COMPANY_IDENTITY_ENDPOINT=${VITE_COMPANY_IDENTITY_ENDPOINT}
ENV VITE_COMPANY_IDENTITY_CLIENT_ID=${VITE_COMPANY_IDENTITY_CLIENT_ID}
RUN pnpm --filter @iep/company-console build

FROM workspace AS applicant-build
RUN pnpm --filter @iep/applicant-interview build

FROM nginx:1.27.5-alpine AS company-console
COPY apps/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=company-build /app/apps/company-console/dist /usr/share/nginx/html

FROM nginx:1.27.5-alpine AS applicant-interview
COPY apps/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=applicant-build /app/apps/applicant-interview/dist /usr/share/nginx/html
