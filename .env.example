# Local application mode. Copy this file to .env; never commit .env.
APP_ENV=local
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:5173
APPLICANT_BASE_URL=http://localhost:5174
API_BASE_URL=http://localhost:8001

# Local PostgreSQL defaults. These values are for the disposable Compose service only.
POSTGRES_DB=interview_evidence
POSTGRES_USER=interview
POSTGRES_PASSWORD=interview_local
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://interview:interview_local@localhost:5432/interview_evidence

# Local AWS-compatible services. Application tests use deterministic fakes by default.
AWS_REGION=ap-northeast-2
AWS_ENDPOINT_URL=http://localhost:4566
DYNAMODB_ENDPOINT_URL=http://localhost:8000
LOCALSTACK_PORT=4566
DYNAMODB_PORT=8000
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_PORT=9200
SUBMISSION_BUCKET=iep-local-submissions
MEDIA_BUCKET=iep-local-media
ANALYSIS_QUEUE_NAME=iep-local-analysis

# Security-sensitive values must be supplied outside source control when a real adapter is enabled.
APP_SIGNING_KEY=
COMPANY_JWT_ISSUER=
COMPANY_JWT_AUDIENCE=
COMPANY_JWKS_URL=
APPLICANT_SESSION_TTL_SECONDS=3600
SIGNED_URL_TTL_SECONDS=300
DEFAULT_RETENTION_DAYS=180

# External AI calls remain disabled unless an approved profile and explicit opt-in are provided.
ENABLE_LIVE_AWS=false
AWS_PROFILE=
BEDROCK_MODEL_ID=
TRANSCRIBE_LANGUAGE_CODE=ko-KR
POLLY_VOICE_ID=Seoyeon
